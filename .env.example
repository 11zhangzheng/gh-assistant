# ── LLM API ────────────────────────────────────────────────
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxx

# Model ID (any Anthropic-compatible model)
MODEL_ID=claude-sonnet-4-6

# Optional: Anthropic-compatible providers (DeepSeek / GLM / Kimi / MiniMax)
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
# MODEL_ID=deepseek-v4-flash

# ── GitHub ─────────────────────────────────────────────────
# Fine-grained PAT with Issues: read+write on the repos you run gh-assistant on.
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxx

# Optional: default repo for the `interactive` command (owner/name)
# GHA_REPO=yourname/yourrepo
