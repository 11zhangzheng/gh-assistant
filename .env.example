# Model provider: anthropic or openai
GHA_PROVIDER=anthropic
GHA_MODEL=claude-sonnet-4-6

# Set only the credential for the selected provider.
ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# OPENAI_API_KEY=replace-me
# OPENAI_BASE_URL=https://api.openai.com/v1

# Fine-grained token scoped to repositories used by gh-assistant.
GITHUB_TOKEN=replace-me

# auto prefers Docker and requests approval before local fallback.
GHA_EXECUTOR=auto
GHA_DOCKER_IMAGE=gh-assistant-python:3.12
GHA_STATE_DIR=.gha

# Optional report cost estimation.
# GHA_INPUT_COST_PER_MILLION=3.0
# GHA_OUTPUT_COST_PER_MILLION=15.0
